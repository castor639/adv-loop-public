{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "contradiction_resolutions": {
      "maxItems": 0,
      "type": "array"
    },
    "contradictions": {
      "maxItems": 0,
      "type": "array"
    },
    "criterion_updates": {
      "maxItems": 0,
      "type": "array"
    },
    "decisions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "minLength": 1,
            "type": "string"
          },
          "rationale": {
            "minLength": 1,
            "type": "string"
          },
          "rejected_alternatives": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "decision",
          "rationale"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "evidence": {
      "maxItems": 0,
      "type": "array"
    },
    "overlay_review": {
      "additionalProperties": false,
      "properties": {
        "narrowed_delta": {
          "type": "object"
        },
        "reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "target_attempt_id": {
          "pattern": "^A[0-9]{6}$",
          "type": "string"
        },
        "uncertainty": {
          "minLength": 1,
          "type": "string"
        },
        "verdict": {
          "enum": [
            "adopt",
            "reject",
            "narrow"
          ]
        }
      },
      "required": [
        "target_attempt_id",
        "verdict",
        "reasons",
        "uncertainty"
      ],
      "type": "object"
    }
  },
  "required": [
    "overlay_review",
    "decisions"
  ],
  "title": "ADV Loop model output for critic/overlay_review (policy 5.0)",
  "type": "object"
}
