{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "action": {
      "minLength": 1,
      "type": "string"
    },
    "contradiction_resolutions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_ids": {
            "description": "ids of evidence already recorded in the workspace (E000012 form); never a verdict id",
            "items": {
              "pattern": "^E[0-9]{6}$",
              "type": "string"
            },
            "type": "array"
          },
          "evidence_refs": {
            "description": "ref values of evidence entries in this same submission (never verdict ids or paths)",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "resolution": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "resolution"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "contradictions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_ids": {
            "description": "ids of evidence already recorded in the workspace (E000012 form); never a verdict id",
            "items": {
              "pattern": "^E[0-9]{6}$",
              "type": "string"
            },
            "type": "array"
          },
          "evidence_refs": {
            "description": "ref values of evidence entries in this same submission (never verdict ids or paths)",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "noncritical"
            ]
          }
        },
        "required": [
          "id",
          "claim",
          "severity"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "criterion_updates": {
      "maxItems": 0,
      "type": "array"
    },
    "decisions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "minLength": 1,
            "type": "string"
          },
          "rationale": {
            "minLength": 1,
            "type": "string"
          },
          "rejected_alternatives": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "decision",
          "rationale"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "artifact_path"
            ]
          },
          {
            "required": [
              "verdict_id"
            ]
          }
        ],
        "properties": {
          "artifact_path": {
            "description": "Workspace-relative path; the harness computes the fingerprint.",
            "minLength": 1,
            "type": "string"
          },
          "claim": {
            "minLength": 1,
            "type": "string"
          },
          "formalization_rank": {
            "enum": [
              "sourced_claim",
              "replicated_experiment",
              "executable_spec",
              "smt_discharge",
              "model_check",
              "kernel_proof"
            ]
          },
          "independence_key": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "minLength": 1,
            "type": "string"
          },
          "locator": {
            "minLength": 1,
            "type": "string"
          },
          "method": {
            "minLength": 1,
            "type": "string"
          },
          "quality": {
            "enum": [
              "direct",
              "indirect"
            ]
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "supports": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "theory_base_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "verdict_id": {
            "description": "A checker verdict id issued in this session by adv-validate.",
            "pattern": "^V[0-9]{4}$",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "kind",
          "quality",
          "claim",
          "method",
          "independence_key",
          "supports"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "hypothesis": {
      "minLength": 1,
      "type": "string"
    },
    "interpretation": {
      "minLength": 1,
      "type": "string"
    },
    "next_step": {
      "minLength": 1,
      "type": "string"
    },
    "observation_notes": {
      "description": "Your reading of the recorded tool results. The raw observation is generated by the harness.",
      "minLength": 1,
      "type": "string"
    },
    "outcome": {
      "enum": [
        "progress",
        "no_progress",
        "failed",
        "inconclusive"
      ]
    },
    "report": {
      "additionalProperties": false,
      "properties": {
        "criterion_results": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "conclusion": {
                "minLength": 1,
                "type": "string"
              },
              "criterion_id": {
                "type": "string"
              },
              "primary_evidence_ids": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "verification_evidence_ids": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "criterion_id",
              "conclusion",
              "primary_evidence_ids",
              "verification_evidence_ids"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "facts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "claim": {
                "minLength": 1,
                "type": "string"
              },
              "evidence_ids": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "claim",
              "evidence_ids"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "inferences": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "basis_evidence_ids": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "claim": {
                "minLength": 1,
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            },
            "required": [
              "claim",
              "basis_evidence_ids",
              "confidence"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "next_actions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        },
        "uncertainties": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "unresolved_noncritical_contradiction_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "summary",
        "criterion_results",
        "facts",
        "inferences",
        "uncertainties",
        "limitations",
        "unresolved_noncritical_contradiction_ids",
        "next_actions"
      ],
      "type": "object"
    },
    "strategy": {
      "additionalProperties": false,
      "properties": {
        "decomposition": {
          "minLength": 1,
          "type": "string"
        },
        "reasoning_method": {
          "minLength": 1,
          "type": "string"
        },
        "retrieval_method": {
          "minLength": 1,
          "type": "string"
        },
        "source_class": {
          "minLength": 1,
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "type": "string"
        },
        "verification_method": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "decomposition",
        "source_class",
        "retrieval_method",
        "reasoning_method",
        "tool",
        "verification_method"
      ],
      "type": "object"
    },
    "uncertainties": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "strategy",
    "hypothesis",
    "action",
    "observation_notes",
    "interpretation",
    "uncertainties",
    "next_step",
    "outcome",
    "evidence",
    "criterion_updates",
    "contradictions",
    "contradiction_resolutions",
    "decisions",
    "report"
  ],
  "title": "ADV Loop model output for synthesizer/final_report (policy 5.0)",
  "type": "object"
}
