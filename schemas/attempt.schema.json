{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adv-loop.local/schemas/attempt.schema.json",
  "title": "ADV Loop normalized attempt (policy 2.0 and 3.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "at", "request_id", "directive_id", "role", "mode", "actor",
    "evidence", "criterion_updates", "contradictions", "contradiction_resolutions", "decisions"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^A[0-9]{6}$"},
    "at": {"type": "string", "format": "date-time"},
    "request_id": {"type": "string", "minLength": 1},
    "directive_id": {"type": "string", "pattern": "^D-[0-9a-f]{24}$"},
    "role": {"enum": ["planner", "researcher", "critic", "verifier", "synthesizer", "explorer", "surgeon"]},
    "mode": {"enum": ["initial_plan", "experiment", "attempt_review", "contradiction_search", "decompose", "fresh_replan", "blocker_audit", "independent_verification", "final_report", "ideation", "triage", "overlay_diagnosis", "overlay_review"]},
    "actor": {"$ref": "evidence.schema.json#/properties/actor"},
    "strategy": {"$ref": "https://adv-loop.local/schemas/attempt.schema.json#/$defs/strategy"},
    "strategy_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hypothesis": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "observation": {"type": "string", "minLength": 1},
    "interpretation": {"type": "string", "minLength": 1},
    "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "next_step": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["progress", "no_progress", "failed", "inconclusive"]},
    "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
    "criterion_updates": {"type": "array", "items": {"type": "object"}},
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "contradiction_resolutions": {"type": "array", "items": {"type": "object"}},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "plan": {"type": "object"},
    "plan_id": {"type": "string"},
    "criterion_targets": {"type": "array", "items": {"type": "string"}},
    "assessment": {"type": "object"},
    "contradiction_search": {"type": "object"},
    "blocker_audit": {"type": "object"},
    "verification_results": {"type": "array", "items": {"type": "object"}},
    "report": {"$ref": "report.schema.json"},
    "review": {"type": "object"},

    "basin": {"type": "string", "minLength": 1},
    "representation_shift": {"type": "string", "minLength": 1},
    "move": {"enum": ["test", "survey", "barrier_probe", "combine", "replicate"]},
    "candidate_id": {"type": "string", "pattern": "^Q[0-9]{4}$"},
    "assets_registered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "locator"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_ids"],
      "properties": {
        "asset_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}
      }
    },
    "barrier_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "approach"],
      "properties": {
        "barrier_id": {"type": "string", "pattern": "^BR[0-9]{4}$"},
        "new_barrier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "statement"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "statement": {"type": "string", "minLength": 1}
          }
        },
        "pattern": {"enum": ["bound", "dual", "shift_representation"]},
        "approach": {"type": "string", "minLength": 1}
      }
    },
    "replication_of": {"type": "string", "pattern": "^A[0-9]{6}$"},
    "wishes_declared": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "would_open", "test", "recheck_after"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "would_open": {"type": "string", "minLength": 1},
          "test": {"type": "string", "minLength": 1},
          "recheck_after": {"type": "string", "format": "date-time"}
        }
      }
    },
    "proposed_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "rationale"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "lens": {"enum": ["correctness", "novelty", "proves_too_much", "simplification"]},

    "context_scope": {"const": "minimal"},
    "ideation_kind": {"enum": ["broad", "evolve"]},
    "seeds": {"type": "array", "minItems": 3, "maxItems": 24, "items": {"$ref": "https://adv-loop.local/schemas/attempt.schema.json#/$defs/seed"}},
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_attempt_id", "verdicts", "comparisons"],
      "properties": {
        "target_attempt_id": {"type": "string", "pattern": "^A[0-9]{6}$"},
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seed_index", "decision", "reason"],
            "properties": {
              "seed_index": {"type": "integer", "minimum": 0},
              "decision": {"enum": ["killed", "promoted"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seed_index", "candidate_id", "winner", "rationale"],
            "properties": {
              "seed_index": {"type": "integer", "minimum": 0},
              "candidate_id": {"type": "string", "pattern": "^Q[0-9]{4}$"},
              "winner": {"enum": ["seed", "candidate"]},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"enum": ["planner", "researcher", "critic", "verifier", "synthesizer"]}, "mode": {"not": {"const": "triage"}}}, "required": ["role"]},
      "then": {"required": ["strategy", "strategy_fingerprint", "hypothesis", "action", "observation", "interpretation", "uncertainties", "next_step", "outcome"]}
    },
    {
      "if": {"properties": {"role": {"const": "explorer"}}, "required": ["role"]},
      "then": {"required": ["context_scope", "ideation_kind", "seeds"]}
    },
    {
      "if": {"properties": {"mode": {"const": "triage"}}, "required": ["mode"]},
      "then": {"required": ["triage"]}
    }
  ],
  "$defs": {
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decomposition", "source_class", "retrieval_method", "reasoning_method", "tool", "verification_method"],
      "properties": {
        "decomposition": {"type": "string", "minLength": 1},
        "source_class": {"type": "string", "minLength": 1},
        "retrieval_method": {"type": "string", "minLength": 1},
        "reasoning_method": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "verification_method": {"type": "string", "minLength": 1}
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "basin", "first_unjustified_step", "kill_test", "fingerprint"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "basin": {"type": "string", "minLength": 1},
        "first_unjustified_step": {"type": "string", "minLength": 1},
        "kill_test": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "control_object": {"type": "string", "minLength": 1},
        "needs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "parents": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^Q[0-9]{4}$"}},
        "representation_shift": {"type": "string", "minLength": 1}
      }
    }
  }
}
