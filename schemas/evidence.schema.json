{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adv-loop.local/schemas/evidence.schema.json",
  "title": "ADV Loop normalized evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "at", "kind", "quality", "claim", "locator", "method", "fingerprint",
    "independence_key", "supports", "producer_attempt_id", "producer_role", "actor"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^E[0-9]{6}$"},
    "at": {"type": "string", "format": "date-time"},
    "kind": {"type": "string", "minLength": 1},
    "quality": {"enum": ["direct", "indirect"]},
    "claim": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "independence_key": {"type": "string", "minLength": 1},
    "supports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "formalization_rank": {
      "enum": ["sourced_claim", "replicated_experiment", "executable_spec", "smt_discharge", "model_check", "kernel_proof"]
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checker_id", "checker_version", "accepted", "artifact_hash"],
      "properties": {
        "checker_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "checker_version": {"type": "string", "minLength": 1},
        "accepted": {"type": "boolean"},
        "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "log_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "toolchain_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attestation": {
          "description": "Policy 5.0 checker HMAC, when present. Version and signature enforcement remain engine gates.",
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "theory_base_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer_attempt_id": {"type": "string", "pattern": "^A[0-9]{6}$"},
    "producer_role": {"enum": ["planner", "researcher", "critic", "verifier", "synthesizer"]},
    "actor": {
      "type": "object",
      "required": ["agent_id", "model", "context_id"],
      "additionalProperties": {"type": "string", "minLength": 1},
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "context_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
